#!/sbin/openrc-run
#
# Compressed swap in memory (zram): pages the system has not used for a
# while are kept compressed in RAM instead of being dropped, so a Pi with
# little memory holds more before anything gets killed. Nothing goes to
# the SD card. The size is all of the RAM on boards with less than 8 GB,
# half of it from 8 GB up, or the MiB in /data/etc/zram (0 turns it
# off); restarting applies a new size.

description="Compressed swap in memory"

CONF=/data/etc/zram
DEV=/dev/zram0
SYS=/sys/block/zram0

depend() {
	need runo-data
}

size_mib() {
	if [ -s $CONF ]; then
		tr -dc '0-9' < $CONF
	else
		ram=$(($(sed -n 's/^MemTotal: *\([0-9]*\) kB/\1/p' /proc/meminfo) / 1024))
		# An 8 GB board shows a little under 8 GiB; boards come in 1, 2,
		# 4, 8 and 16 GB, so 6 GiB tells them apart.
		if [ "$ram" -lt 6144 ]; then echo "$ram"; else echo $((ram / 2)); fi
	fi
}

start() {
	mib=$(size_mib)
	[ "${mib:-0}" -gt 0 ] || return 0
	modprobe zram 2>/dev/null
	if [ ! -e $SYS ]; then
		ewarn "the kernel has no zram"
		return 0
	fi
	ebegin "Setting up ${mib} MiB of compressed swap"
	# lz4 is faster than the default lzo-rle at a little less squeeze.
	modprobe lz4 2>/dev/null
	grep -qw lz4 $SYS/comp_algorithm && echo lz4 > $SYS/comp_algorithm
	echo "${mib}M" > $SYS/disksize &&
		mkswap $DEV >/dev/null &&
		swapon $DEV
	eend $?
}

stop() {
	[ -e $SYS ] || return 0
	ebegin "Turning off compressed swap"
	grep -q "^$DEV " /proc/swaps && swapoff $DEV
	echo 1 > $SYS/reset
	eend 0
}

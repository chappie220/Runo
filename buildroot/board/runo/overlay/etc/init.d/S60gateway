#!/bin/sh
#
# The Runo Gateway (chats on other apps, scheduled jobs, the Web UI), when
# `runo gateway install` turned it on: it leaves /data/runo/gateway.enabled.

PIDFILE=/run/runo-gateway.pid
ENABLED=/data/runo/gateway.enabled
export HOME=/root RUNO_HOME=/data/runo

start() {
	[ -e $ENABLED ] || return 0
	start-stop-daemon -S -q -b -m -p $PIDFILE -x /bin/sh -- \
		-c 'exec /usr/bin/runo serve >>/var/log/runo.log 2>&1'
}

stop() {
	start-stop-daemon -K -q -p $PIDFILE
	rm -f $PIDFILE
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	enable) touch $ENABLED ;;
	disable) rm -f $ENABLED ;;
	status)
		if start-stop-daemon -K -t -q -p $PIDFILE; then echo running; else echo stopped; exit 3; fi
		;;
	*) echo "Usage: $0 {start|stop|restart|enable|disable|status}"; exit 1 ;;
esac

#!/bin/sh
#
# runod: pairing and remote management for clients on the network. It
# needs no model, so it runs whatever state the Agent is in.

PIDFILE=/run/runod.pid
export HOME=/root RUNO_HOME=/data/runo
PASSWORD_TXT=/boot/runo-password.txt

# runo-password.txt on the boot partition: the device password, for a Pi
# with no screen. Read once, kept only as a hash, then deleted. With a
# password and no client yet, the pairing window opens by itself.
password_from_boot() {
	[ -f "$PASSWORD_TXT" ] || return 0
	password=$(tr -d '\r' < "$PASSWORD_TXT" | sed -n '/^[[:space:]]*#/d;/[^[:space:]]/{p;q}')
	if [ -n "$password" ]; then
		printf '%s\n' "$password" | /usr/bin/runo daemon password >/dev/null 2>>/var/log/runod.log &&
			echo "runod: device password set from the boot partition"
	fi
	mount -o remount,rw /boot && rm -f "$PASSWORD_TXT"
	mount -o remount,ro /boot
}

case "$1" in
	start)
		password_from_boot
		start-stop-daemon -S -q -b -m -p $PIDFILE -x /bin/sh -- \
			-c 'exec /usr/bin/runo daemon run >>/var/log/runod.log 2>&1'
		;;
	stop)
		start-stop-daemon -K -q -p $PIDFILE
		rm -f $PIDFILE
		;;
	status)
		if start-stop-daemon -K -t -q -p $PIDFILE; then echo running; else echo stopped; exit 3; fi
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

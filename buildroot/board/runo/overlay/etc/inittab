# Runo: BusyBox init and OpenRC, as on Alpine. tty1 is the Agent's
# window, started again when it ends; there is no login prompt.
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

tty1::respawn:/usr/libexec/runo-console

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
